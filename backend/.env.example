# ==============================================================================
# RevenueShield — Backend Production Environment Template (.env.example)
# Contains variable NAMES only. NEVER put real values in this file.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE
# ------------------------------------------------------------------------------
DATABASE_URL=

# ------------------------------------------------------------------------------
# 2. RAZORPAY
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
EXECUTION_MODE=

# ------------------------------------------------------------------------------
# 3. TWILIO
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WEBHOOK_BASE_URL=
TWILIO_STATUS_CALLBACK_URL=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_TO=
COMMUNICATION_MODE=
TWILIO_WHATSAPP_MODE=
WHATSAPP_MODE=

# ------------------------------------------------------------------------------
# 4. EMAIL
# ------------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
SMTP_USE_TLS=

# ------------------------------------------------------------------------------
# 5. SECURITY
# ------------------------------------------------------------------------------
INTERNAL_API_SECRET=
ALLOWED_ORIGINS=

# ------------------------------------------------------------------------------
# 6. ML
# ------------------------------------------------------------------------------
ATTRIBUTION_WINDOW_HOURS=
RETRAINING_SCHEDULE_THRESHOLD=

# ------------------------------------------------------------------------------
# 7. APPLICATION
# ------------------------------------------------------------------------------
ENVIRONMENT=
DEBUG=
PORT=
HOST=
MAX_VOICE_ATTEMPTS=
MAX_WHATSAPP_ATTEMPTS=
VOICE_COOLDOWN_MINUTES=
WHATSAPP_COOLDOWN_MINUTES=
DND_START_TIME=
DND_END_TIME=
DEFAULT_TIMEZONE=

# ------------------------------------------------------------------------------
# 8. V2: MEASUREMENT, AGENT, JOBS, OBSERVABILITY
# ------------------------------------------------------------------------------
EXPERIMENTS_ENABLED=true
HOLDOUT_PERCENT=10
HOLDOUT_PERCENT_BY_SURFACE=
AGENT_DRIVES_PLANS=true
LLM_PROVIDER=auto            # auto | anthropic | openai | null   (auto: Claude if ANTHROPIC_API_KEY, else GPT if OPENAI_API_KEY, else rules)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=              # paste your OpenAI key here to plan with GPT-4o
OPENAI_BASE_URL=             # optional, for Azure/OpenAI-compatible gateways
LLM_MODEL_PLANNER=claude-opus-5
LLM_MODEL_PLANNER_OPENAI=gpt-4o
LLM_EFFORT=medium
NEGOTIATION_MAX_INSTALLMENTS=3
NEGOTIATION_MIN_FIRST_PAYMENT_PCT=30
NEGOTIATION_MAX_WAIVER_PCT=0
APPROVAL_VOICE_AMOUNT_THRESHOLD=50000
APPROVAL_SLA_HOURS=24
CONTACT_VOICE_START_HOUR=8
CONTACT_VOICE_END_HOUR=19
CONTACT_MAX_TOUCHES_7D=3
DND_REGISTRY_NUMBERS=
JOBS_ENABLED=true
WORKER_POLL_SECONDS=5
LOG_JSON=false
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=
