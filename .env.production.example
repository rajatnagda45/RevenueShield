# ==============================================================================
# RevenueShield — Production Environment Template (.env.production.example)
# Configuration for AWS / GCP / DigitalOcean / Render / Kubernetes
# ==============================================================================

# Core Runtime
ENVIRONMENT=production
DEBUG=False
PORT=8000
HOST=0.0.0.0
ALLOWED_ORIGINS=https://app.revenueshield.io,https://dashboard.revenueshield.io

# PostgreSQL High-Availability Database Connection
DATABASE_URL=postgresql+psycopg2://revenueshield_app:YOUR_STRONG_DB_PASSWORD@prod-db.internal.net:5432/revenueshield_production

# Razorpay Production API Credentials
RAZORPAY_KEY_ID=rzp_live_PLACEHOLDER
RAZORPAY_KEY_SECRET=PLACEHOLDER_LIVE_SECRET
RAZORPAY_WEBHOOK_SECRET=PLACEHOLDER_WEBHOOK_SECRET
EXECUTION_MODE=razorpay_live

# Twilio Production Voice & Communication
TWILIO_ACCOUNT_SID=AC_PLACEHOLDER
TWILIO_AUTH_TOKEN=PLACEHOLDER_AUTH_TOKEN
TWILIO_PHONE_NUMBER=+14155550199
TWILIO_WEBHOOK_BASE_URL=https://api.revenueshield.io
TWILIO_STATUS_CALLBACK_URL=https://api.revenueshield.io/webhooks/twilio/status
COMMUNICATION_MODE=twilio
TWILIO_WHATSAPP_MODE=PRODUCTION
WHATSAPP_MODE=REAL

# Enterprise SMTP Relay (SendGrid / AWS SES / Mailgun)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=PLACEHOLDER_SMTP_API_KEY
SMTP_FROM_EMAIL=no-reply@revenueshield.io
SMTP_FROM_NAME=RevenueShield Payment Recovery
SMTP_USE_TLS=True

# Internal Security Secret for Admin Endpoints
INTERNAL_API_SECRET=GENERATE_A_64_CHAR_HEX_SECRET

# ML & Recovery Engine
ATTRIBUTION_WINDOW_HOURS=72
RETRAINING_SCHEDULE_THRESHOLD=100
MAX_VOICE_ATTEMPTS=3
MAX_WHATSAPP_ATTEMPTS=3
VOICE_COOLDOWN_MINUTES=60
WHATSAPP_COOLDOWN_MINUTES=1440
DND_START_TIME=20:00
DND_END_TIME=08:00
DEFAULT_TIMEZONE=Asia/Kolkata
